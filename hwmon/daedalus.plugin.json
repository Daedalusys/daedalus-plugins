{
  "id": "daedalus.hwmon",
  "name": "Daedalus Hardware Sensors",
  "version": "0.1.0",
  "api_version": "0.1.0",
  "license": "Apache-2.0",
  "maintainer": "team@daedalusys.io",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-hwmon",
  "tools": [
    "hwmon_temperatures",
    "hwmon_fans",
    "hwmon_voltages",
    "hwmon_power",
    "hwmon_battery",
    "hwmon_thermal_zones"
  ],
  "permissions": {
    "read": [
      "/sys/class/hwmon",
      "/sys/class/thermal",
      "/sys/class/power_supply",
      "/sys/class/powercap"
    ],
    "write": [],
    "run": []
  },
  "i18n": [
    "en_US",
    "zh_CN"
  ]
}

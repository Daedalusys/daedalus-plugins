{
  "id": "daedalus.avc",
  "name": "Daedalus SELinux AVC Denial Query",
  "version": "0.1.0",
  "api_version": "0.1.0",
  "license": "Apache-2.0",
  "maintainer": "team@daedalusys.io",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-avc",
  "tools": [
    "avc_recent",
    "avc_explain",
    "avc_summary"
  ],
  "permissions": {
    "read": [
      "/var/log/audit",
      "/etc/selinux"
    ],
    "write": [],
    "run": [
      "/usr/sbin/ausearch",
      "/usr/bin/audit2why",
      "/usr/bin/audit2allow"
    ]
  },
  "i18n": [
    "en_US",
    "zh_CN"
  ]
}
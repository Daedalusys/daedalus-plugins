{
  "id": "daedalus.smart",
  "name": "Daedalus SMART Health",
  "version": "0.1.0",
  "api_version": "0.1.0",
  "license": "Apache-2.0",
  "maintainer": "team@daedalusys.io",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-smart",
  "tools": [
    "smart_list",
    "smart_health",
    "smart_attributes",
    "smart_test"
  ],
  "permissions": {
    "read": [
      "/dev/disk",
      "/sys/block",
      "/run/udev"
    ],
    "write": [],
    "run": [
      "/usr/sbin/smartctl",
      "/usr/bin/smartctl"
    ]
  },
  "i18n": [
    "en_US",
    "zh_CN"
  ]
}

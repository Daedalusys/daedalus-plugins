{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.os/blueprints/redis-acl/schema.json",
  "title": "Redis ACL 用户",
  "description": "添加或修改 Redis ACL 用户所需的输入参数。",
  "type": "object",
  "additionalProperties": false,
  "required": ["user", "password"],
  "properties": {
    "user": {
      "type": "string",
      "description": "ACL 用户名。同时用作输出文件名的占位符 {user}。",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "password": {
      "type": "string",
      "description": "ACL 用户密码。仅接受 secret:// 引用(如 secret://kwallet/redis/user),由蓝图插件解析,不落明文。",
      "pattern": "^secret://"
    },
    "allowed_commands": {
      "type": "array",
      "description": "允许执行的命令列表,默认 [GET, SET, DEL]。",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z|]+$"
      },
      "default": ["GET", "SET", "DEL"]
    },
    "allowed_keys": {
      "type": "array",
      "description": "允许访问的键模式(glob),默认 [*]。",
      "items": {
        "type": "string",
        "pattern": "^[^*]|\\*"
      },
      "default": ["*"]
    }
  }
}

-- PostgreSQL 用户与权限脚本
-- 由 daedalus-blueprint 渲染;输出到 /etc/postgresql/daedalus/{user}-{db}.sql
-- 密码经 secret:// 引用解析后由蓝图插件安全注入,本文件不落明文(仅含占位符 {{.password}})。
-- 注意:此模板使用 Go text/template 语法,占位符(形如 {param} 的路径模板,与 schema.json 字段一一对应)。

-- 创建/修改用户 {{ .user }}:不存在则创建,存在则仅更新密码
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{{ .user }}') THEN
        CREATE USER {{ .user }} WITH PASSWORD '{{ .password }}';
    ELSE
        ALTER USER {{ .user }} WITH PASSWORD '{{ .password }}';
    END IF;
END
$$;

-- 对数据库 {{ .db }} 循环授予权限
GRANT CONNECT ON DATABASE {{ .db }} TO {{ .user }};
{{- range .privileges }}
GRANT {{ . }} ON ALL TABLES IN SCHEMA public TO {{ $.user }};
GRANT {{ . }} ON ALL SEQUENCES IN SCHEMA public TO {{ $.user }};
{{- end }}

{{/* INSERTION_POINT */}}
-- 其他授权语句(如表级/列级 GRANT)可插入到此处

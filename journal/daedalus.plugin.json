{
  "id": "daedalus.journal",
  "name": "Daedalus Journal Query",
  "version": "0.1.0",
  "api_version": "0.1.0",
  "license": "Apache-2.0",
  "maintainer": "team@daedalusys.io",
  "type": "capability",
  "runtime": {
    "name": "native"
  },
  "executable": "bin/daedalus-journal",
  "tools": [
    "journal_query",
    "journal_follow",
    "journal_last_boot"
  ],
  "permissions": {
    "read": [
      "/var/log/journal",
      "/run/log/journal"
    ],
    "write": [],
    "run": [
      "/usr/bin/journalctl"
    ]
  },
  "i18n": [
    "en_US",
    "zh_CN"
  ]
}
